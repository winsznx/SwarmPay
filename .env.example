# SwarmPay — environment template. Copy to `.env.local` and fill in real values.
# `.env.local` is gitignored; this file is the safe-to-commit reference.

# ─── Supabase ───────────────────────────────────────────────────────────
# Persistence layer for tasks + payment_intents. Create a project at
# https://supabase.com/dashboard, then run supabase_master_setup.sql.

# Public URL for your Supabase project — Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Anon (public) key — safe to ship to the browser. Settings → API → anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — server-only, bypasses RLS. Settings → API → service_role.
# Never expose to client; used for privileged writes from API routes.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Circle (Developer-Controlled Wallets + USDC on Arc) ────────────────
# Give every agent a real on-chain wallet. Sign up at
# https://console.circle.com and generate credentials in the Developer tab.

# Circle API key — Developer → API Keys → New Key.
CIRCLE_API_KEY=TEST_API_KEY:...

# Entity secret (hex, 32 bytes) — generated once via
# `scripts/setup-wallets.ts` or the Circle console. Guard like a private key.
CIRCLE_ENTITY_SECRET=0123456789abcdef...

# Wallet set ID — output of Circle `createWalletSet`. All six agent wallets
# live inside this set. See scripts/setup-wallets.ts.
CIRCLE_WALLET_SET_ID=01ab...

# USDC token ID on Arc testnet. Run scripts/find-token-id.ts to resolve.
USDC_TOKEN_ID=01234567-89ab-cdef-0123-456789abcdef

# Per-agent wallet IDs — created by scripts/setup-wallets.ts. One per agent.
WALLET_ID_CRYPTO_SCOUT_X=01ab...
WALLET_ID_RESEARCH_ALPHA=01ab...
WALLET_ID_DATA_MINER_PRO=01ab...
WALLET_ID_PARSER_X=01ab...
WALLET_ID_ANALYSIS_NODE=01ab...
WALLET_ID_COMPUTE_GRID_4=01ab...

# ─── Intelligence (LLM providers) ───────────────────────────────────────
# Agent reasoning. Gemini is primary, Groq is fallback, OpenAI drives the
# orchestrator appraisal. Any one is enough for a working demo; all three
# present gives the best behavior.

# Google AI Studio key — https://aistudio.google.com/app/apikey. Drives the
# Gemini 2.0 Flash call in src/lib/execution.ts.
GEMINI_API_KEY=AIzaSy...

# Groq key — https://console.groq.com/keys. Secondary fallback when Gemini
# returns empty text.
GROQ_API_KEY=gsk_...

# OpenAI key — https://platform.openai.com/api-keys. Used by the orchestrator
# intelligence appraisal step (swarmIntelligenceAppraisal).
OPENAI_API_KEY=sk-proj-...

# ─── Arc Chain (settlement layer) ───────────────────────────────────────
# Forward-looking: the current pipeline settles via Circle's transaction
# API, which handles RPC internally. These vars are reserved for Phase D
# when we wire a direct BatchSettlement.sol call via viem/ethers.

# Arc testnet RPC endpoint.
ARC_RPC_URL=https://rpc.arc.example

# Arc chain ID (integer).
ARC_CHAIN_ID=0

# Public explorer base URL. Canonical value used across the app:
ARC_EXPLORER_URL=https://testnet.arcscan.app

# ─── Platform config ────────────────────────────────────────────────────
# Forward-looking: currently hard-coded in src/lib/pipeline.ts. Exposed here
# so a future refactor can make them configurable without code changes.

# Share of user budget that accrues to the platform (0-100).
PLATFORM_FEE_PERCENT=10

# Sandbox compute cost per millisecond, in USDC. Drives the compute meter.
COMPUTE_COST_PER_MS=0.000001

# ─── Dev ────────────────────────────────────────────────────────────────

# Port the Next dev server binds to. Matches the `dev` script in package.json.
PORT=3001

# ─── Internal endpoint auth ─────────────────────────────────────────────

# Shared secret protecting /api/settlement/drain. The drain endpoint
# self-recurses via fire-and-forget HTTP — without this, anyone on the
# internet could POST a taskId and trigger DB queries against your
# project. Set in prod; leave unset in dev (endpoint is permissive when
# the env var is missing).
# Generate with: openssl rand -hex 32
SETTLEMENT_DRAIN_SECRET=
